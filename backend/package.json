{
  "name": "@ticketflow/backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --selectProjects unit integration",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:coverage": "jest --selectProjects unit integration --coverage",
    "db:migrate": "tsx src/db/cli/migrate.ts",
    "db:migrate:status": "tsx src/db/cli/migrate.ts --status",
    "db:migrate:prod": "node dist/db/cli/migrate.js",
    "admin": "tsx src/db/cli/admin.ts",
    "admin:prod": "node dist/db/cli/admin.js",
    "db:seed": "tsx src/db/cli/seed.ts",
    "test:live": "node scripts/run-live-tests.js",
    "test:concurrency": "node scripts/run-live-tests.js concurrency",
    "test:sandbox": "node scripts/run-live-tests.js sandbox",
    "e2e:server": "tsx tests/e2e/server.ts",
    "db:schema-report": "node scripts/schema-report.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^18.7.0-beta.19",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
