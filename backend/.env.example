# ---------- Runtime ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated explicit origin allowlist (no wildcards)
CORS_ORIGINS=http://localhost:5173
# Trust N reverse-proxy hops (needed for correct client IP / rate limiting behind a proxy)
TRUST_PROXY=0

# ---------- Supabase PostgreSQL ----------
# Use the Supabase *session pooler* (port 5432) or direct connection URI.
# Transaction pooler (6543) does not support session features used by migrations.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---------- Redis ----------
# rediss:// for TLS (e.g. Upstash)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=ticketflow:

# ---------- Auth (used from Phase 2) ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12
TEST_BYPASS_OTP=false

# ---------- Business rules ----------
MAX_TICKETS_PER_USER_PER_EVENT=6
SEAT_HOLD_TTL_SECONDS=300
DEFAULT_CURRENCY=BDT

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---------- Seed (never enable in production) ----------
ALLOW_SEED=false
